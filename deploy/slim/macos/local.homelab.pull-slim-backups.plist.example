<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.homelab.pull-slim-backups</string>
  <key>ProgramArguments</key><array><string>/Users/YOUR_USER/.local/bin/pull-slim-backups</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Backups/slim/pull.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Backups/slim/pull.log</string>
</dict>
</plist>

{
  "title": "Router (ASUS RT-AX56U)",
  "uid": "router-asus",
  "tags": [
    "router",
    "home-lab"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Collector",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(vector(3) and on() ((min(up{job=\"router\"}) == 0) or (min(rtax_exporter_up) == 0))) or (vector(2) and on() (max(time() - rtax_last_attempt_timestamp_seconds) > 300)) or (vector(1) and on() ((max(rtax_last_attempt_success) == 0) or (max(rtax_incident_open) == 1))) or (vector(0) and on() (max(rtax_last_attempt_success) == 1)) or vector(3)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "STALE",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "UNAVAILABLE",
                  "color": "purple",
                  "index": 3
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "purple",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "description": "OK = last attempt succeeded and is fresh. FAILING = last attempt failed or an incident is open. STALE = no attempt for more than 5 minutes. UNAVAILABLE = the router exporter is down or reporting nothing. (systemd rtax-collector, key auth, every 60s.)"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last collection",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - rtax_last_attempt_timestamp_seconds) and on() (up{job=\"router\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "description": "Seconds since the last attempt; over 5 min means the collector has stopped."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Router uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },

            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(rtax_router_uptime_seconds) and on() (up{job=\"router\"} == 1) and on() (rtax_exporter_up == 1) and on() ((time() - rtax_last_sample_timestamp_seconds) < 300)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 8,
      "type": "stat",
      "title": "Router collector",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(vector(3) and on() (absent(up{job=\"router\"}) or absent(rtax_exporter_up) or (min(up{job=\"router\"}) < 1) or (min(rtax_exporter_up) < 1))) or (vector(2) and on() (max(time() - rtax_last_attempt_timestamp_seconds) > 300)) or (vector(1) and on() ((min(rtax_last_attempt_success) < 1) or (max(rtax_incident_open) > 0))) or (vector(0) and on() (min(up{job=\"router\"}) == 1) and on() (min(rtax_exporter_up) == 1) and on() (max(time() - rtax_last_attempt_timestamp_seconds) <= 300) and on() (min(rtax_last_attempt_success) == 1) and on() (max(rtax_incident_open) == 0)) or vector(3)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "purple",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "STALE",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "UNAVAILABLE",
                  "color": "purple",
                  "index": 3
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "description": "OK only when the scrape and exporter both report healthy, the last attempt is under 5 minutes old, it succeeded and no incident is open; every one of those metrics must be present. FAILING = last attempt failed or an incident is open. STALE = no attempt for more than 5 minutes. UNAVAILABLE = the scrape or exporter is down or missing, or any metric needed for OK is absent. Precedence: UNAVAILABLE, STALE, FAILING, OK."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\"}[2m])) / on() group_left sum(rate(node_cpu_seconds_total{job=\"node\"}[2m])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

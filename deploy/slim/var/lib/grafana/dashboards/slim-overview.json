{
  "uid": "slim-overview",
  "title": "Slim overview",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "slim",
    "home-lab"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "home-lab"
      ],
      "targetBlank": false,
      "title": "Home lab",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\"}[2m])) / sum(rate(node_cpu_seconds_total{job=\"node\"}[2m])) * 100) and on() (up{job=\"node\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "description": "Busy share of total CPU time across all cores (non-idle / all modes). Same basis as the CPU by mode chart, so the stacked total equals this tile."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory",

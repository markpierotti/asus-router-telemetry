          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})) and on() (up{job=\"node\"} == 1)",
          "legendFormat": "",

    {
      "id": 3,
      "type": "stat",
      "title": "Disk /",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs|overlay\"} - node_filesystem_free_bytes{job=\"node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs|overlay\"}) / ((node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs|overlay\"} - node_filesystem_free_bytes{job=\"node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs|overlay\"}) + node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs|overlay\"})) and on() (up{job=\"node\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 99
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "description": "Root filesystem Use%, computed the way df does: used / (used + space available to non-root users). df rounds this up to a whole number."
    },

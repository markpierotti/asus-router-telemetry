    {
      "id": 12,
      "type": "timeseries",
      "title": "DNS queries per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": true,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",

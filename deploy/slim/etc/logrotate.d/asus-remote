/var/log/asus/asus.log {
    daily
    rotate 30
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    firstaction
        /usr/local/bin/slim-syslog-storage check || exit 1
    endscript
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

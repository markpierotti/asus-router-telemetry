[Unit]
Description=Prometheus metrics from the ASUS access point's syslog
Documentation=file:///usr/local/bin/asus-syslog-metrics

[Service]
Type=oneshot
Environment=SLIM_IP=192.0.2.10
ExecStart=/usr/local/bin/asus-syslog-metrics
# Root without capabilities: reading /var/log/asus needs the adm group.
SupplementaryGroups=adm
StateDirectory=asus-syslog-metrics
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
TimeoutStartSec=60

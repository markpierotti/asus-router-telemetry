[Unit]
Description=ASUS RT-AX56U telemetry collector (key auth, 60s loop)
After=network-online.target
Wants=network-online.target

[Service]
User=rtax
Group=rtax
WorkingDirectory=/home/rtax/app/collector
# -E -s: ignore PYTHON* env and user site (not -I: that drops the script dir from sys.path)
ExecStart=/usr/bin/python3 -E -s collector.py collect --loop --interval 60 --data-dir /home/rtax/data
# Requires collector 1.6.2 or later; do not pair this unit with 1.6.0.
# 130 = orderly stop on SIGTERM. Exit 4 = loop host-key/artifact HARD STOP;
# 2 = bad config: neither is retried. Exit 1 = other collection/CLI failure;
# 3 = lock held or a storage error taking it: both are retried.
SuccessExitStatus=130
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=4 2
# SIGTERM goes to the collector only; it removes its router work dir through the
# ssh control master, then stops the master itself. Leftovers are SIGKILLed after.
KillMode=mixed
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rtax/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

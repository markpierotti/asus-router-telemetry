#!/usr/bin/python3
"""Create/check the fixed disk budget for ASUS logs. Never format an existing image."""
import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

IMAGE = Path('/var/lib/asus-syslog-storage/logs.ext4')
MOUNT = Path('/var/log/asus')
SIZE_MIB = 256


def regular_image(path, size):
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o600:
        raise ValueError('image must be a root-owned regular file with mode 0600')
    if st.st_size != size or st.st_blocks * 512 < size:
        raise ValueError('image must have the exact, fully allocated disk budget')
    return st


def create(image, size):
    parent = image.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = parent.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
        raise ValueError('image directory must be root-owned mode 0700')
    fs = os.statvfs(parent)
    if fs.f_bavail * fs.f_frsize < size + 1024 ** 3:
        raise ValueError('insufficient space: image budget plus 1 GiB reserve required')
    fd = os.open(image, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.posix_fallocate(fd, 0, size)
        os.fsync(fd)
    finally:
        os.close(fd)
    regular_image(image, size)
    # Discard would punch holes in the reservation while formatting the image.
    subprocess.run(['/usr/sbin/mkfs.ext4', '-q', '-E', 'nodiscard', '-m', '0',
                    '-F', str(image)], check=True)
    regular_image(image, size)
    print('created fixed log image; mount and migrate logs separately')


def check(image, mount, size):
    expected = regular_image(image, size)
    output = subprocess.check_output(
        ['/usr/bin/findmnt', '--json', '--mountpoint', str(mount),
         '--output', 'SOURCE,FSTYPE,OPTIONS,TARGET'], text=True)
    rows = json.loads(output)['filesystems']
    if len(rows) != 1:
        raise ValueError('expected exactly one mounted filesystem')
    row = rows[0]
    if row['target'] != str(mount) or row['fstype'] != 'ext4':
        raise ValueError('expected ext4 mounted at the exact log directory')
    if not {'rw', 'nodev', 'nosuid', 'noexec'} <= set(row['options'].split(',')):
        raise ValueError('required mount options missing')
    source = row['source']
    if not re.fullmatch(r'/dev/loop[0-9]+', source):
        raise ValueError('expected a loop-backed log filesystem')
    backing = Path('/sys/class/block') / Path(source).name / 'loop/backing_file'
    actual = Path(backing.read_text().strip()).stat()
    if (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino):
        raise ValueError('mount uses a different backing image')
    fs = os.statvfs(mount)
    if fs.f_blocks * fs.f_frsize > size:
        raise ValueError('mounted filesystem exceeds the configured budget')


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('command', choices=('create', 'check'))
    p.add_argument('--image', type=Path, default=IMAGE)
    p.add_argument('--mountpoint', type=Path, default=MOUNT)
    p.add_argument('--size-mib', type=int, default=SIZE_MIB)
    a = p.parse_args()
    if os.geteuid() != 0:
        p.error('must run as root')
    if not a.image.is_absolute() or not a.mountpoint.is_absolute() or a.size_mib < 16:
        p.error('absolute paths and a budget of at least 16 MiB are required')
    try:
        if a.command == 'create':
            create(a.image, a.size_mib * 1024 ** 2)
        else:
            check(a.image, a.mountpoint, a.size_mib * 1024 ** 2)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
        print('ASUS log storage refused: ' + str(e), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

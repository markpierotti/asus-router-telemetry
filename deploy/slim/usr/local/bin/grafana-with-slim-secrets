#!/bin/sh
# Alert provisioning expands environment variables, not $__file{} providers.
set -eu
SLIM_TELEGRAM_BOT_TOKEN=$(cat /etc/slim-secrets/telegram_bot_token)
SLIM_TELEGRAM_CHAT_ID=$(cat /etc/slim-secrets/telegram_chat_id)
test -n "$SLIM_TELEGRAM_BOT_TOKEN"
test -n "$SLIM_TELEGRAM_CHAT_ID"
export SLIM_TELEGRAM_BOT_TOKEN SLIM_TELEGRAM_CHAT_ID
exec "$@"

#!/usr/bin/env python3
"""Deterministic Prometheus metrics from the ASUS access point's syslog.

Run every minute by asus-syslog-metrics.timer. Reads lines appended to
/var/log/asus/asus.log since the last run (whole lines only, finishing a rotated
file before the new one) and writes counters for the node-exporter textfile
collector. Independent of Hermes: if the agent is down, Grafana still alerts on
these. Log text is matched, never executed or interpreted.
"""
import json
import os
import re
import sys
import time
from pathlib import Path

LOG = Path(os.environ.get("ASUS_LOG", "/var/log/asus/asus.log"))
STATE = Path(os.environ.get("STATE_DIRECTORY", "/var/lib/asus-syslog-metrics")) / "state.json"
PROM = Path(os.environ.get("PROM_FILE", "/var/lib/prometheus/node-exporter/asus_syslog.prom"))
SLIM_IP = os.environ.get("SLIM_IP", "")
MAX_BYTES = 4_000_000

PATTERNS = {
    "restart": re.compile(r"klogd started|kernel: Linux version|syslogd started"),
    "auth_failure": re.compile(r"(?i)bad password|login fail|failed password|auth(?:entication)? fail"
                               r"|invalid user|wrong password|unauthori[sz]ed"),
    "wifi_driver_error": re.compile(r"(?i)\b(?:wl\d|dhd|eth[5-7]|wlceventd|acsd)\b.*"
                                    r"\b(?:error|fail(?:ed|ure)?|timeout|trap|assert|watchdog|firmware)\b"),
}
LOGIN_RE = re.compile(r"(?i)(?:password|pubkey) auth succeeded|login success|logged in")
IP_RE = re.compile(r"\b(\d{1,3}(?:\.\d{1,3}){3})\b")


def read_chunk(path, off, final=False):
    with path.open("rb") as f:
        size = os.fstat(f.fileno()).st_size
        f.seek(off)
        data = f.read(MAX_BYTES)
    # A rotated file (final=True) gets no more writes: take its unterminated tail.
    if not data.endswith(b"\n") and not (final and off + len(data) >= size):
        nl = data.rfind(b"\n")
        if nl >= 0:
            data = data[:nl + 1]
        elif len(data) < MAX_BYTES:
            data = b""
    new_off = off + len(data)
    return data, new_off, new_off >= size


def read_new(state):
    try:
        st = LOG.stat()
    except FileNotFoundError:
        return ""
    ino, off = state.get("inode"), state.get("offset", 0)
    old_text = b""
    if ino is not None and ino != st.st_ino:
        old = LOG.with_name(LOG.name + ".1")
        try:
            ost = old.stat()
        except OSError:
            ost = None
        if ost is not None and ost.st_ino == ino and off < ost.st_size:
            old_text, new_off, done = read_chunk(old, off, final=True)
            if not done:
                state["offset"] = new_off
                return old_text.decode("utf-8", "replace")
            if old_text and not old_text.endswith(b"\n"):
                old_text += b"\n"    # its unterminated last record ends here
        off = 0
    elif st.st_size < off:
        off = 0
    data, new_off, _ = read_chunk(LOG, off)
    state["inode"], state["offset"] = st.st_ino, new_off
    return (old_text + data).decode("utf-8", "replace")


def main():
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    counts = state.setdefault("counts", {})
    for name in ["lines", "login_other", *PATTERNS]:
        counts.setdefault(name, 0)

    for line in read_new(state).splitlines():
        if not line.strip():
            continue
        counts["lines"] += 1
        for name, rx in PATTERNS.items():
            if rx.search(line):
                counts[name] += 1
        if LOGIN_RE.search(line) and not PATTERNS["auth_failure"].search(line):
            if any(ip != SLIM_IP for ip in IP_RE.findall(line)) or not IP_RE.search(line):
                counts["login_other"] += 1

    last = state.get("last_line", 0)
    try:
        st = LOG.stat()
        if st.st_size > 0:          # an empty or freshly rotated file proves nothing
            last = st.st_mtime
    except OSError:
        pass
    state["last_line"] = last

    help_text = {
        "lines": "Syslog lines received from the ASUS access point.",
        "restart": "ASUS restarts (or logger restarts) seen in its syslog.",
        "auth_failure": "Failed login attempts seen in the ASUS syslog.",
        "login_other": "Successful ASUS logins from anywhere other than Slim.",
        "wifi_driver_error": "Wi-Fi driver error-like lines in the ASUS syslog.",
    }
    out = ["# HELP asus_syslog_last_line_timestamp_seconds Time the ASUS syslog file last received a line.",
           "# TYPE asus_syslog_last_line_timestamp_seconds gauge",
           f"asus_syslog_last_line_timestamp_seconds {last:.0f}"]
    for name, text in help_text.items():
        metric = f"asus_syslog_{name}_total"
        out += [f"# HELP {metric} {text}", f"# TYPE {metric} counter", f"{metric} {counts[name]}"]
    out += ["# HELP asus_syslog_metrics_run_timestamp_seconds Last successful run of asus-syslog-metrics.",
            "# TYPE asus_syslog_metrics_run_timestamp_seconds gauge",
            f"asus_syslog_metrics_run_timestamp_seconds {time.time():.0f}"]

    tmp = PROM.with_name(PROM.name + ".tmp")
    tmp.write_text("\n".join(out) + "\n")
    tmp.chmod(0o644)
    os.replace(tmp, PROM)
    stmp = STATE.with_suffix(".tmp")
    stmp.write_text(json.dumps(state))
    os.replace(stmp, STATE)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Minimal read-only Prometheus exporter for Pi-hole v6.

Reads Pi-hole's own SQLite databases (no API session or password needed) and
serves metrics on 127.0.0.1:9617/metrics. Standard library only.

FTL flushes queries to pihole-FTL.db every database.DBinterval seconds
(60 by default), so figures lag real time by up to a minute.
"""
import sqlite3
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

FTL_DB = "/etc/pihole/pihole-FTL.db"
GRAVITY_DB = "/etc/pihole/gravity.db"
NAMES_FILE = "/etc/pihole-exporter/names"  # lines of "ip name"
LISTEN = ("127.0.0.1", 9617)
TOP_N = 10

# Pi-hole v6 query status codes
BLOCKED = (1, 4, 5, 6, 7, 8, 9, 10, 11, 15, 16, 18)
STATUS = {
    0: "unknown", 1: "gravity", 2: "forwarded", 3: "cache", 4: "regex",
    5: "denylist", 6: "external_ip", 7: "external_null", 8: "external_nxra",
    9: "gravity_cname", 10: "regex_cname", 11: "denylist_cname", 12: "retried",
    13: "retried_dnssec", 14: "in_progress", 15: "db_busy", 16: "special_domain",
    17: "cache_stale", 18: "external_ede15",
}
BLOCKED_SQL = ",".join(str(s) for s in BLOCKED)


def connect(path):
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)


def names():
    out = {}
    try:
        with open(NAMES_FILE) as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and not parts[0].startswith("#"):
                    out[parts[0]] = " ".join(parts[1:])
    except OSError:
        pass
    return out


def esc(v):
    return str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def collect():
    lines = []

    def metric(name, help_, type_, samples):
        lines.append(f"# HELP {name} {help_}")
        lines.append(f"# TYPE {name} {type_}")
        for labels, value in samples:
            lab = ",".join(f'{k}="{esc(v)}"' for k, v in labels.items())
            lines.append(f"{name}{{{lab}}} {value}" if lab else f"{name} {value}")

    now = int(time.time())
    ok = 1
    try:
        db = connect(FTL_DB)
        q = db.execute
        total = q("SELECT COALESCE(MAX(id), 0) FROM query_storage").fetchone()[0]
        metric("pihole_query_id_max",
               "Highest query id stored (monotonic; use rate() for queries/s)",
               "counter", [({}, total)])

        for window, secs in (("5m", 300), ("1h", 3600), ("24h", 86400)):
            since = now - secs
            n, b = q(f"SELECT COUNT(*), COALESCE(SUM(status IN ({BLOCKED_SQL})), 0) "
                     "FROM query_storage WHERE timestamp > ?", (since,)).fetchone()
            metric(f"pihole_queries_{window}", f"DNS queries in the last {window}",
                   "gauge", [({}, n)])
            metric(f"pihole_blocked_{window}", f"Blocked queries in the last {window}",
                   "gauge", [({}, b)])
            metric(f"pihole_blocked_ratio_{window}",
                   f"Fraction of queries blocked in the last {window}",
                   "gauge", [({}, round(b / n, 4) if n else 0)])

        since = now - 86400
        rows = q("SELECT status, COUNT(*) FROM query_storage WHERE timestamp > ? "
                 "GROUP BY status", (since,)).fetchall()
        metric("pihole_queries_by_status_24h", "Queries in the last 24h by status",
               "gauge", [({"status": STATUS.get(s, str(s))}, c) for s, c in rows])

        nm = names()
        rows = q("SELECT client, COUNT(*), SUM(status IN (%s)) FROM queries "
                 "WHERE timestamp > ? GROUP BY client ORDER BY 2 DESC LIMIT ?"
                 % BLOCKED_SQL, (since, TOP_N)).fetchall()
        metric("pihole_client_queries_24h", "Top clients by queries in the last 24h",
               "gauge", [({"client": c, "name": nm.get(c, c)}, n) for c, n, _ in rows])
        metric("pihole_client_blocked_24h", "Blocked queries per top client, last 24h",
               "gauge", [({"client": c, "name": nm.get(c, c)}, b or 0) for c, _, b in rows])

        rows = q("SELECT domain, COUNT(*) FROM queries WHERE timestamp > ? "
                 "AND status IN (%s) GROUP BY domain ORDER BY 2 DESC LIMIT ?"
                 % BLOCKED_SQL, (since, TOP_N)).fetchall()
        metric("pihole_top_blocked_domain_24h", "Most blocked domains, last 24h",
               "gauge", [({"domain": d}, n) for d, n in rows])

        rows = q("SELECT domain, COUNT(*) FROM queries WHERE timestamp > ? "
                 "AND status NOT IN (%s) GROUP BY domain ORDER BY 2 DESC LIMIT ?"
                 % BLOCKED_SQL, (since, TOP_N)).fetchall()
        metric("pihole_top_allowed_domain_24h", "Most queried allowed domains, last 24h",
               "gauge", [({"domain": d}, n) for d, n in rows])

        rows = q("SELECT forward, COUNT(*), AVG(reply_time) FROM queries "
                 "WHERE timestamp > ? AND status IN (2, 12, 13) AND forward IS NOT NULL "
                 "GROUP BY forward", (since,)).fetchall()
        metric("pihole_upstream_queries_24h", "Queries forwarded per upstream, last 24h",
               "gauge", [({"upstream": u}, n) for u, n, _ in rows])
        metric("pihole_upstream_reply_seconds_avg_24h",
               "Average upstream reply time, last 24h", "gauge",
               [({"upstream": u}, round(t or 0, 4)) for u, _, t in rows])

        last = q("SELECT COALESCE(MAX(timestamp), 0) FROM query_storage").fetchone()[0]
        metric("pihole_last_query_timestamp_seconds",
               "Unix time of the newest stored query", "gauge", [({}, last)])
        db.close()
    except sqlite3.Error:
        ok = 0

    try:
        g = connect(GRAVITY_DB)
        dom = g.execute("SELECT COUNT(*) FROM gravity").fetchone()[0]
        lists = g.execute("SELECT COUNT(*) FROM adlist WHERE enabled = 1").fetchone()[0]
        upd = g.execute("SELECT value FROM info WHERE property = 'updated'").fetchone()
        g.close()
        metric("pihole_gravity_domains", "Domains on the blocklist (gravity)",
               "gauge", [({}, dom)])
        metric("pihole_adlists_enabled", "Enabled blocklists", "gauge", [({}, lists)])
        if upd:
            metric("pihole_gravity_updated_timestamp_seconds",
                   "Unix time gravity was last rebuilt", "gauge", [({}, int(upd[0]))])
    except sqlite3.Error:
        ok = 0

    metric("pihole_exporter_up", "1 if both databases were read", "gauge", [({}, ok)])
    return "\n".join(lines) + "\n"


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != "/metrics":
            self.send_error(404)
            return
        body = collect().encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    ThreadingHTTPServer(LISTEN, Handler).serve_forever()

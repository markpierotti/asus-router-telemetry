#!/bin/sh
# Back up and roll back the provisioned Grafana dashboards on Slim.
#
#   slim-dashboards backup
#   slim-dashboards rollback BACKUP_DIR NAME...     (NAME: slim-overview, pihole, router)
#
# Every step runs as root. The backup directory is root-owned and 0750, so an
# unprivileged "does this file exist?" test cannot tell "absent" from "permission
# denied". This script therefore escalates first and refuses to continue unless it
# can read the backup. It deletes a dashboard only after establishing, as root, that
# the backup is valid (a readable directory holding pihole.json and router.json,
# which always exist) and does not contain that dashboard. Anything doubtful aborts
# before the live directory is touched.
#
# SLIM_DASHBOARD_DIR, SLIM_BACKUP_ROOT and SLIM_SUDO exist for tests; leave them unset.
set -eu

LIVE=${SLIM_DASHBOARD_DIR:-/var/lib/grafana/dashboards}
BACKUP_ROOT=${SLIM_BACKUP_ROOT:-/var/backups}
SUDO=${SLIM_SUDO:-sudo}
REQUIRED="pihole router"          # present before this change, so always in a valid backup
KNOWN="slim-overview pihole router"

die() { echo "slim-dashboards: $*" >&2; exit 1; }

if [ "${1:-}" = "--elevated" ]; then
    shift
elif [ "$(id -u)" -ne 0 ]; then
    self=$(readlink -f "$0")
    exec $SUDO sh "$self" --elevated "$@"
fi
[ "$(id -u)" -eq 0 ] || die "must run as root; could not elevate"
umask 027

known() { for k in $KNOWN; do [ "$k" = "$1" ] && return 0; done; return 1; }
required() { for k in $REQUIRED; do [ "$k" = "$1" ] && return 0; done; return 1; }

cmd=${1:-}
[ -n "$cmd" ] || die "usage: slim-dashboards backup | rollback BACKUP_DIR NAME..."
shift

case "$cmd" in
backup)
    [ -d "$LIVE" ] || die "dashboard directory $LIVE not found"
    for n in $REQUIRED; do [ -f "$LIVE/$n.json" ] || die "$LIVE/$n.json missing; refusing to make an incomplete backup"; done
    dest=$(mktemp -d "$BACKUP_ROOT/grafana-dashboards-$(date +%Y%m%d-%H%M%S).XXXXXX")
    # Copy entries one by one: `cp -a dir/. dest/` would also copy the live
    # directory's mode and owner onto the private backup directory.
    # A failed find -exec with a semicolon does not make find itself fail. Copy
    # in the shell so failure of ANY entry (including the overview) aborts.
    for entry in "$LIVE"/* "$LIVE"/.[!.]* "$LIVE"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        cp -a "$entry" "$dest"/ || die "backup copy failed; incomplete directory: $dest"
    done
    chown root:root "$dest"
    chmod 0750 "$dest"
    for n in $REQUIRED; do [ -f "$dest/$n.json" ] || die "backup verification failed for $n.json"; done
    echo "$dest"
    ;;
rollback)
    backup=${1:-}; [ -n "$backup" ] || die "rollback needs BACKUP_DIR"
    shift
    [ "$#" -gt 0 ] || die "rollback needs at least one dashboard name"
    [ -d "$backup" ] || die "backup $backup is missing or not a directory; nothing changed"
    [ -r "$backup" ] && [ -x "$backup" ] || die "backup $backup is not readable; nothing changed"
    [ -d "$LIVE" ] || die "dashboard directory $LIVE not found"
    for n in $REQUIRED; do
        [ -f "$backup/$n.json" ] && [ -r "$backup/$n.json" ] || die "backup $backup is not a valid backup ($n.json missing or unreadable); nothing changed"
    done
    # Preflight every name before changing anything.
    for n in "$@"; do
        known "$n" || die "unknown dashboard '$n' (expected one of: $KNOWN); nothing changed"
        if [ ! -e "$backup/$n.json" ] && [ ! -L "$backup/$n.json" ]; then
            required "$n" && die "$n.json should be in the backup but is not; nothing changed"
        else
            [ -f "$backup/$n.json" ] && [ -r "$backup/$n.json" ] || die "$backup/$n.json is not a readable file; nothing changed"
        fi
    done
    for n in "$@"; do
        if [ -f "$backup/$n.json" ]; then
            cp -a "$backup/$n.json" "$LIVE/$n.json"
            echo "restored $n.json"
        else
            rm -f "$LIVE/$n.json"
            echo "removed $n.json (absent from valid backup)"
        fi
    done
    ;;
*)
    die "unknown command '$cmd'"
    ;;
esac
